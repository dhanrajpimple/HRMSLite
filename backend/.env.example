# ──────────────────────────────────────────────
# HRMS Lite – Backend Environment Variables
# ──────────────────────────────────────────────
# Copy this file:   cp .env.example .env
# Then fill in real values before starting.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/hrms_db

# Comma-separated list of allowed CORS origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# "development" | "production"
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
